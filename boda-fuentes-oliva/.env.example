# Frontend
# Leave empty to use same-origin /api (recommended)
# Example for local + Vercel dev: VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=

# Backend (Vercel Serverless + local vercel dev)
# Add in Vercel Dashboard -> Project Settings -> Environment Variables
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require&channel_binding=require
NEON_DATABASE_URL_DIRECT=postgresql://user:password@host/db?sslmode=require&channel_binding=require
